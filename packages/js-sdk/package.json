{
  "name": "@aegis/js-sdk",
  "version": "1.0.0",
  "description": "AEGIS BOT SHIELD browser SDK: behavioural telemetry, headless and anti-detect checks, proof of work",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/browser.ts --bundle --minify --sourcemap --format=iife --global-name=Aegis --target=es2019 --outfile=dist/aegis.min.js",
    "test": "node scripts/build-scrypt-wasm.mjs --check && vitest run",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint src --ext .ts",
    "build:wasm": "node scripts/build-scrypt-wasm.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "author": "dipro20debnath",
  "license": "MIT",
  "devDependencies": {
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3",
    "wabt": "^1.0.39"
  },
  "unpkg": "dist/aegis.min.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "bot-detection",
    "browser",
    "sdk",
    "security",
    "fingerprinting"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipro20debnath/AEGIS-BOT-SHIELD.git",
    "directory": "packages/js-sdk"
  },
  "homepage": "https://github.com/dipro20debnath/AEGIS-BOT-SHIELD#readme",
  "bugs": {
    "url": "https://github.com/dipro20debnath/AEGIS-BOT-SHIELD/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
